---
import SidebarNav from "./SidebarNav";
---

<aside
    id="sidebar"
    aria-hidden="true"
    class="fixed left-0 top-0
     z-40 h-screen
     bg-black/85 lg:bg-transparent
     transform transition-transform duration-300
     -translate-x-full lg:translate-x-0">

    <nav class="relative h-full p-8 pt-[88px] lg:pt-[110px]">
        <!-- Links -->
        <SidebarNav client:load />

        <!-- CV downloads: same light as the nav, in the CV's red -->
        <div class="mt-8 space-y-1">
            <p class="font-mono text-xs text-zinc-400 mb-2 tracking-wide">cv</p>
            <a class="nav-link flex items-center gap-2 py-1.5 font-mono text-base" style="--ink: #ff465a"
               href="/cv/andreas-roos-cv-en.pdf" download>
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4v13M6 11l6 6 6-6M5 21h14" />
                </svg>
                <span data-cv>cv (en)</span>
            </a>
            <a class="nav-link flex items-center gap-2 py-1.5 font-mono text-base" style="--ink: #ff465a"
               href="/cv/andreas-roos-cv-sv.pdf" download>
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4v13M6 11l6 6 6-6M5 21h14" />
                </svg>
                <span data-cv>cv (sv)</span>
            </a>
        </div>

    </nav>
</aside>

<script>
    import { sketchOnHover } from "../lib/sketch";

    // CV downloads: rough red underline on hover, matching their ctp-red accent
    document.addEventListener("astro:page-load", () => {
        document.querySelectorAll("[data-cv]").forEach((el) => {
            if (el instanceof HTMLElement) {
                sketchOnHover(el, {
                    color: "#ff465a", // catppuccin red
                    type: "underline",
                    strokeWidth: 1.5,
                    padding: 3,
                    drawMs: 420,
                    undrawMs: 220,
                });
            }
        });
    });
</script>
