---
import SidebarNav from "./SidebarNav";
---

<!-- Phones: a drawer that slides in over a scrim (SidebarToggle owns the
     open state, aria-hidden and inert). Desktop: always there. -->
<aside
    id="sidebar"
    class="fixed left-0 top-0
     z-40 h-screen w-[72vw] max-w-[20rem] lg:w-auto lg:max-w-none
     bg-black/[0.96] lg:bg-transparent
     transform transition-transform duration-[350ms] ease-[cubic-bezier(0.32,0.72,0,1)]
     touch-pan-y lg:touch-auto
     -translate-x-full lg:translate-x-0">

    <nav class="relative h-full p-8 pt-[88px] lg:pt-[110px]">
        <!-- Links -->
        <SidebarNav client:load />

        <!-- CV downloads: same light as the nav -->
        <div class="mt-8 space-y-1">
            <p class="font-mono text-xs text-zinc-400 mb-2 tracking-wide">CV</p>
            <a class="nav-link flex items-center gap-2 py-1.5 font-mono text-base"
               href="/cv/andreas-roos-cv-en.pdf" download>
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4v13M6 11l6 6 6-6M5 21h14" />
                </svg>
                <span data-cv>English PDF</span>
            </a>
            <a class="nav-link flex items-center gap-2 py-1.5 font-mono text-base"
               href="/cv/andreas-roos-cv-sv.pdf" download>
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4v13M6 11l6 6 6-6M5 21h14" />
                </svg>
                <span data-cv>Svensk PDF</span>
            </a>
        </div>

    </nav>
</aside>

<script>
    import { sketchOnHover } from "../lib/sketch";

    // CV downloads: the nav's rough underline on hover, in the cloud-shade ink
    document.addEventListener("astro:page-load", () => {
        document.querySelectorAll("[data-cv]").forEach((el) => {
            if (el instanceof HTMLElement) {
                sketchOnHover(el, {
                    color: "rgb(184 197 214)",
                    type: "underline",
                    strokeWidth: 1.5,
                    padding: 3,
                    drawMs: 420,
                    undrawMs: 220,
                });
            }
        });
    });
</script>
