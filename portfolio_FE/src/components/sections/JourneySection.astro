---
/**
 * Journey: the chapter mark (02 JOURNEY + hook) stays on the left of the
 * pinned viewport while the coaster pile builds on the right - vertical
 * scroll lands each milestone card on the previous one with a cascade
 * offset (smoothScroll.ts drives the transforms). On mobile the same pin
 * plays as a vertical deck: cards rise from below and land nearly flush.
 */
import ChapterMark from "./ChapterMark.astro";

type Milestone = {
    n: string;
    cmd: string;
    color: string;
    title: string;
    paras: string[];
    /** Names carry more weight scanned as a list than buried in a sentence,
     *  so only the milestone that earns a roll call gets one. */
    credits?: { label: string; names: string[] }[];
};

const milestones: Milestone[] = [
    {
        "n": "01",
        "cmd": "music",
        "color": "text-ctp-green",
        "title": "Studio & stage",
        "paras": [
            "My work in music has included drumming, musical direction, MIDI and playback engineering, mixing, and production.",
            "I was also a songwriter and producer signed to TEN Music Group."
        ],
        "credits": [
            {
                "label": "selected studio credits",
                "names": [
                    "Liam Payne",
                    "Astrid S",
                    "Vault Boy"
                ]
            },
            {
                "label": "selected live credits",
                "names": [
                    "Benjamin Ingrosso",
                    "Veronica Maggio",
                    "Loreen"
                ]
            }
        ]
    },
    {
        "n": "02",
        "cmd": "studies",
        "color": "text-ctp-blue",
        "title": "Learning software",
        "paras": [
            "I studied Java development at Nackademin. That gave me a grounding in object-oriented programming, databases, networking, and testing.",
            "Backend development was my starting point. I use Kotlin and Java with Spring Boot or Ktor in my projects."
        ]
    },
    {
        "n": "03",
        "cmd": "internship",
        "color": "text-ctp-mauve",
        "title": "Bluetooth at Sigma",
        "paras": [
            "During my internship at Sigma Connectivity, I worked on an Android app for Bluetooth testing, using Kotlin and Jetpack Compose.",
            "The work included device scanning, GATT operations, and Lua test scripts, followed by work with LE Audio. I enjoyed investigating what happened when the devices didn't behave as expected."
        ]
    },
    {
        "n": "04",
        "cmd": "audio tools",
        "color": "text-ctp-peach",
        "title": "What I'm building",
        "paras": [
            "I'm developing a release-preparation tool for the studio and experimenting with audio watermarking in C++.",
            "Both come from problems I know through music work: handling release files and exploring how information can travel inside audio. The projects below show where that work stands."
        ]
    }
];
---

<section id="journey" data-section="journey" data-snap
         data-cmd="./journey --walk" data-cmd-color="#94e2d5"
         class="relative">

    <div data-cardstack data-off-x="26" data-off-y="48" class="journey-stack relative z-10" style={`--journey-edges: ${milestones.length - 1}`}>
        <div class="journey-viewport">
            <!-- lg:items-start: the mark's numeral tops out level with the
                 first card's top edge instead of floating centered -->
            <div class="relative z-10 w-full flex flex-col lg:flex-row items-center lg:items-start lg:justify-center gap-5 lg:gap-[3vw] px-4 lg:px-[2vw] py-4 lg:py-0">
                <!-- Chapter mark: stays for the whole pinned pile -->
                <div class="shrink-0 text-center lg:text-left">
                    <ChapterMark n="02" label="JOURNEY"
                                 line1="From stage to" accent="stack trace" color="#94e2d5"
 />
                </div>

                <!-- The coaster pile -->
                <div class="stack-area">
                    {milestones.map((m, i) => (
                        <div data-stack-card style={`z-index: ${i + 1}`}>
                            <div class="edit-card h-full">
                                <div class="edit-head">
                                    <span class="text-zinc-400">journey/{m.n}.log</span>
                                </div>
                                <div class="edit-body">
                                    <div class={`font-mono text-xs mb-2 ${m.color}`}>{m.n} · {m.cmd}</div>
                                    <h3 class="text-2xl md:text-4xl font-bold leading-[1.05] text-white mb-4 md:mb-6">{m.title}</h3>
                                    <div class="space-y-3">
                                        {m.paras.map((p) => (
                                            <p class="text-sm md:text-base text-zinc-300 leading-relaxed max-w-xl">{p}</p>
                                        ))}
                                    </div>
                                    {m.credits && (
                                        <div class="font-mono text-[10px] md:text-[11px] tracking-[0.08em] uppercase text-zinc-500 mt-3 md:mt-4 space-y-1">
                                            <p>credits <span class="text-zinc-700">//</span></p>
                                            {m.credits.map((c) => (
                                                <p>
                                                    <span class="text-zinc-600">{c.label}:</span>{" "}
                                                    <span class="text-zinc-400">{c.names.join(" · ")}</span>
                                                </p>
                                            ))}
                                        </div>
                                    )}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>
