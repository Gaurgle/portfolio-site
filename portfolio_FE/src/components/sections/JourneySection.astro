---
/**
 * Journey: the chapter mark (02 JOURNEY + hook) stays on the left of the
 * pinned viewport while the coaster pile builds on the right - vertical
 * scroll lands each milestone card on the previous one with a cascade
 * offset (smoothScroll.ts drives the transforms). On mobile the same pin
 * plays as a vertical deck: cards rise from below and land nearly flush.
 */
import ChapterMark from "./ChapterMark.astro";

type Milestone = {
    n: string;
    cmd: string;
    color: string;
    title: string;
    paras: string[];

};

const milestones: Milestone[] = [
    {
        n: "01", cmd: "music", color: "text-ctp-green", title: "Studio & stage",
        paras: [
            "I've worked in music since 2009, as a drummer, producer, mix engineer and musical director.",
            "With Benjamin Ingrosso, I turned the artist's ideas into arrangements and a show the musicians and crew could run together. For Veronica Maggio and Loreen, I worked with MIDI and playback."
        ]
    },
    {
        n: "02", cmd: "studies", color: "text-ctp-blue", title: "Learning software",
        paras: [
            "I studied Java development at Nackademin from 2024 to 2026, starting with backend services, databases and testing.",
            "Kotlin became my preferred language. I now use it for APIs with Ktor and Spring Boot, Android apps with Jetpack Compose, and tools for my own work."
        ]
    },
    {
        n: "03", cmd: "internship", color: "text-ctp-mauve", title: "Bluetooth at Sigma",
        paras: [
            "At Sigma Connectivity, I built a Bluetooth test platform: an Android app, a Ktor backend with PostgreSQL, and a Svelte dashboard.",
            "A Lua API let testers write their own sequences. Debugging against real devices led me further into Bluetooth LE and LE Audio, and made me want to keep working in that area."
        ]
    },
    {
        n: "04", cmd: "studio tools", color: "text-ctp-peach", title: "Software at IMRSV",
        paras: [
            "Alongside mastering records, I build Kotlin tools for release preparation and work on integrations, storage, backups and networking.",
            "I use these workflows myself. That gives me a fairly direct reason to check the awkward cases and write tests before trusting a tool with a release."
        ]
    },
    {
        n: "05", cmd: "now", color: "text-ctp-pink", title: "Where I am now",
        paras: [
            "I also work part-time at Code Boss on backend and frontend development for clients, plus customer support.",
            "I'm looking for a backend or Android role where I can work with other developers and grow in a shared codebase. Kotlin is my first choice; Bluetooth and audio are interests I'd like to take further."
        ]
    }
];
---

<section id="journey" data-section="journey" data-snap
         data-cmd="./journey --walk" data-cmd-color="#94e2d5"
         class="relative">

    <div data-cardstack data-off-x="26" data-off-y="48" class="journey-stack relative z-10" style={`--journey-edges: ${milestones.length - 1}`}>
        <div class="journey-viewport">
            <!-- lg:items-start: the mark's numeral tops out level with the
                 first card's top edge instead of floating centered -->
            <div class="relative z-10 w-full flex flex-col lg:flex-row items-center lg:items-start lg:justify-center gap-5 lg:gap-[3vw] px-4 lg:px-[2vw] py-4 lg:py-0">
                <!-- Chapter mark: stays for the whole pinned pile -->
                <div class="shrink-0 text-center lg:text-left">
                    <ChapterMark n="02" label="JOURNEY"
                                 line1="From stage to" accent="stack trace" color="#94e2d5"
 />
                </div>

                <!-- The coaster pile -->
                <div class="stack-area">
                    {milestones.map((m, i) => (
                        <div data-stack-card style={`z-index: ${i + 1}`}>
                            <div class="edit-card h-full">
                                <div class="edit-head">
                                    <span class="text-zinc-400">journey/{m.n}.log</span>
                                </div>
                                <div class="edit-body">
                                    <div class={`font-mono text-xs mb-2 ${m.color}`}>{m.n} · {m.cmd}</div>
                                    <h3 class="text-2xl md:text-4xl font-bold leading-[1.05] text-white mb-4 md:mb-6">{m.title}</h3>
                                    <div class="space-y-3">
                                        {m.paras.map((p) => (
                                            <p class="text-sm md:text-base text-zinc-300 leading-relaxed max-w-xl">{p}</p>
                                        ))}
                                    </div>

                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>
