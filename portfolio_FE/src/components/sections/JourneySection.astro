---
/**
 * Journey: the chapter mark (its hook line) stays on the left of the
 * pinned viewport while the visitor flies through the milestones in depth.
 * Nothing is boxed: each milestone is loose text in the sky that approaches
 * from far off, holds in focus, then passes the camera the way ROOS does
 * (smoothScroll.ts reports --f per milestone, global.css does the flight).
 * Under the mark sits the contents of the four stops, with a
 * pointer riding a rail to the one in focus; each entry flies to its stop.
 * The right
 * margin stays empty, because that is where the prism's light flares. The
 * list has no clearing, so each entry turns to dark ink while a bright cloud
 * is behind it (data-sky-adapt, clouds.ts).
 */
import ChapterMark from "./ChapterMark.astro";

type Milestone = {
    cmd: string;
    title: string;
    /** [[Key words]] are sketched over (AboutSection.astro wires them). */
    paras: string[];

};

const milestones: Milestone[] = [
    {
        cmd: "music", title: "A background in music",
        paras: [
            "I started playing drums at four and began working professionally in music in 2009. I've toured with Benjamin Ingrosso as a drummer and Musical Director, and worked as a MIDI tech for Loreen, Veronica Maggio, and Eva Dahlgren.",
            "Years in studios and on tour made me curious about the technical side, especially routing audio and keeping instruments and playback in sync across different systems. That interest led me to software."
        ]
    },
    {
        cmd: "studies", title: "Studying software",
        paras: [
            "I started the Java Developer programme at Nackademin in 2024 to learn how software works and build some of my own. I graduated in June 2026.",
            "I now work mainly in Kotlin, building [[backend services]] and Android apps. Android also brought me into Bluetooth LE, where software has to work with real devices and their quirks."
        ]
    },
    {
        cmd: "sigma", title: "Android and Bluetooth",
        paras: [
            "At Sigma Connectivity, I worked on a Bluetooth LE test platform that engineers use to test real devices, with test sequences written in Lua.",
            "It joins an Android test app with a Ktor and PostgreSQL backend and a Svelte dashboard where scripts, devices, and results are kept together."
        ]
    },
    {
        cmd: "IMRSV", title: "Software at IMRSV",
        paras: [
            "At IMRSV Music, I build internal software and maintain the infrastructure it runs on. That includes Kotlin tools, service integrations, scheduled jobs, and storage and backup systems. I also mix and master records as part of my role.",
            "Working alongside the people who use these tools helps me spot what slows them down and build for the way the studio works."
        ]
    }
];
---

<section id="journey" data-section="journey"
         class="relative">

    <div data-cardstack data-stack-mode="focus" class="flight-stack relative z-10">
        <div class="flight-viewport">
            <!-- lg:items-start: the stop's headline stands flush with the
                 top of the mark once it has arrived -->
            <div class="relative z-10 w-full flex flex-col lg:flex-row items-center lg:items-start lg:justify-center gap-5 lg:gap-[4vw] px-4 lg:px-[2vw] py-4 lg:py-0">
                <!-- Chapter mark: stays for the whole flight, with the
                     contents of the journey set under it -->
                <div class="chapter-anchor shrink-0 text-center lg:text-left">
                    <ChapterMark line1="How I" line2="got here" />
                    <nav aria-label="Journey stops">
                        <ol data-stack-contents class="stop-contents">
                            {milestones.map((m) => (
                                <li data-sky-adapt>
                                    <button type="button" class="press">
                                        {m.cmd}
                                    </button>
                                </li>
                            ))}
                        </ol>
                    </nav>
                </div>

                <!-- The flight: milestones share one stage, separated in depth.
                     data-lens: the sky clears and bends around it (clouds.ts) -->
                <div class="stack-area" data-lens>
                    {milestones.map((m, i) => (
                        <article data-stack-card data-rn-card class="beam-stop" style={`--f: ${i === 0 ? 0 : -1}`}>
                            <header class="beam-head">
                                <h3 class="beam-title">{m.title}</h3>
                            </header>
                            <div class="beam-copy">
                                {m.paras.map((p) => (
                                    <p>{p.split(/\[\[(.+?)\]\]/).map((part, k) => k % 2
                                        ? <span class="text-white" data-rn="underline">{part}</span>
                                        : part)}</p>
                                ))}
                            </div>
                        </article>
                    ))}
                </div>

            </div>
        </div>
    </div>
</section>
