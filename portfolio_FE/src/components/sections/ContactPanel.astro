---
/**
 * Contact: the closing chapter, revealed under the page as it lifts away.
 * Nothing is boxed: the form is loose text in the panel's black, and the
 * ways to reach Andreas sit under the 04 mark as a plain list, the way the
 * journey lists its stops under 02. The header's GitHub and LinkedIn fade
 * out while this chapter is active (global.css, .site-socials), so the
 * links live here once the visitor arrives.
 */
import ContactForm from "../ContactForm.tsx";
import ChapterMark from "./ChapterMark.astro";

// Filled 24-unit glyphs, one weight, so the three read as a set.
const ICONS = {
    mail: "M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z",
    github: "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z",
    linkedin: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
};

const links = [
    { label: "larsnilsandreas@pm.me", href: "mailto:larsnilsandreas@pm.me", icon: ICONS.mail, external: false },
    { label: "github", href: "https://github.com/gaurgle/", icon: ICONS.github, external: true },
    { label: "linkedin", href: "https://www.linkedin.com/in/andreasrooos/", icon: ICONS.linkedin, external: true },
];
---

<!-- Fixed panel under the page; revealed as the content lifts away at the
     end. The stylesheet hides it until the scroll engine reveals it - keep
     it reachable without JS. -->
<noscript><style>.contact-panel { visibility: visible; }</style></noscript>
<div class="contact-panel" data-section="contact" data-hue="#ffb84d">
    <div class="w-full max-w-6xl px-6 flex flex-col lg:flex-row items-center lg:justify-between gap-4 lg:gap-10">
        <!-- Form on the left -->
        <div class="w-full max-w-xl">
            <ContactForm client:idle />
        </div>

        <!-- Chapter mark on the right (above the form when stacked), with
             the direct lines under it -->
        <div class="shrink-0 order-first lg:order-none flex flex-col items-center lg:items-start gap-3 lg:gap-6">
            <ChapterMark n="04" label="CONTACT"
                         pre="say " accent="hello" color="#ffb84d"
                         width="w-[min(11rem,50vw)] lg:w-[min(24rem,26vw)]" />
            <ul class="contact-links">
                {links.map((l) => (
                    <li>
                        <a href={l.href}
                           target={l.external ? "_blank" : undefined}
                           rel={l.external ? "noopener noreferrer" : undefined}>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.icon} /></svg>
                            <span data-contact-link>{l.label}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</div>

<script>
    import { sketchOnHover } from "../../lib/sketch";

    // Direct lines: rough peach underline on hover, the chapter's colour
    document.addEventListener("astro:page-load", () => {
        document.querySelectorAll("[data-contact-link]").forEach((el) => {
            if (el instanceof HTMLElement) {
                sketchOnHover(el, {
                    color: "#ffb84d",
                    type: "underline",
                    strokeWidth: 1.5,
                    padding: 3,
                    drawMs: 420,
                    undrawMs: 220,
                });
            }
        });
    });
</script>
