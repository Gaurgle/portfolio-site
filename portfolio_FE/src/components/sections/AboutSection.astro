---
/**
 * About: the chapter mark (01 ABOUT + hook) sticks on the right and rides
 * with the story flowing past on the left. The story has no surface: each
 * passage is loose text the sky clears and bends around (data-lens,
 * clouds.ts), and its words converge out of a chromatic split as it arrives. The tech stack lives in
 * the marquee band further down (TechMarquee).
 */
import ChapterMark from "./ChapterMark.astro";
---

<section id="about" data-section="about"
         data-hue="#9d8cff"
         class="relative max-w-6xl mx-auto px-4">

    <div class="lg:flex lg:flex-row-reverse lg:gap-10">
        <!-- Chapter mark: sticky on the right for the whole section. Pulled
             up 40vh on desktop so it rises into the emptied hero screen and
             is already in place when the first passage arrives under it. -->
        <div class="lg:w-[42%] shrink-0 lg:sticky lg:top-0 lg:h-screen lg:-mt-[40vh] flex flex-col justify-center items-center lg:items-end lg:text-right pt-24 lg:pt-0 z-0">
            <ChapterMark n="01" label="ABOUT"
                         line1="Backend. Android." accent="Audio" color="#9d8cff" />
        </div>

        <!-- Story passages on the left, with a small entry hold (little pin) -->
        <!-- Extra tail: about keeps the frame a while before journey arrives -->
        <div data-hold="0.2" class="lg:w-[58%] relative z-10 pt-16 pb-8 lg:pt-[18vh] lg:pb-[18vh]">
            <!-- Big gaps on desktop (each passage owns the frame); compact on
                 mobile where there is no focus effect to justify them -->
            <div data-hold-content class="space-y-14 lg:space-y-[16vh]">

            <div data-reveal data-focus data-lens="soft" class="signal" data-rn-card>
                <h3 class="passage-head text-ctp-mauve">Hello</h3>
                <p data-word-reveal class="signal-copy">I'm Andreas, a <span class="text-white" data-rn="underline">backend</span> and <span class="text-white" data-rn="underline">Android</span> developer in <span class="text-white" data-rn="underline">Stockholm</span>.
                        I mainly write <span class="text-white" data-rn="underline">Kotlin</span> and <span class="text-white" data-rn="underline">Java</span>:
                        backend services, Android apps and tools that take repetitive work out of the day.
                        I have a particular interest in <span class="text-white" data-rn="underline">Bluetooth LE</span> and <span class="text-white" data-rn="underline">LE Audio</span>, following hands-on work at <span class="text-white" data-rn="underline">Sigma Connectivity</span>.
                        Before software, I worked in music and <span class="text-white" data-rn="underline">live production</span>, which I still do alongside development.</p>
            </div>

            <div data-reveal data-focus data-lens="soft" class="signal" data-rn-card>
                <h3 class="passage-head text-ctp-mauve">At IMRSV</h3>
                <p data-word-reveal class="signal-copy">At <span class="text-white" data-rn="underline">IMRSV Music</span>, I <span class="text-white" data-rn="underline">master records</span> and build internal <span class="text-white" data-rn="underline">Kotlin tools</span>.
                        The technical work grew out of the studio's needs: preparing <span class="text-white" data-rn="underline">release files</span>,
                        connecting external platforms, and looking after storage, <span class="text-white" data-rn="underline">backups</span> and networking.
                        I work with the same files and delivery requirements as the people using the tools.</p>
            </div>

            </div>
        </div>
    </div>
</section>

<script>
    import { annotate, annotationGroup } from "rough-notation";

    // The spectrum, cycled across the annotations
    const PALETTE = ["#9d8cff", "#46beff", "#3fe8d2", "#8dffb0", "#ffb84d", "#ff465a"];

    function paddingFor(type) {
        if (type === "circle") return 5;
        if (type === "box") return 4;
        return 2;
    }

    // Wire one card: build its annotation group, reveal on hover, clear on leave
    function setupCard(card, colorOffset) {
        const els = Array.from(card.querySelectorAll("[data-rn]"));
        if (els.length === 0) return;

        // Build the annotations statically (animate: false). rough-notation just
        // renders the rough strokes; WE drive the draw via stroke-dashoffset so it
        // can play forward on hover and in reverse on leave.
        const annotations = els.map((el, i) => {
            const type = el.dataset.rn || "underline";
            return annotate(el, {
                type,
                color: PALETTE[(colorOffset + i) % PALETTE.length],
                strokeWidth: 1.4,
                padding: paddingFor(type),
                multiline: type === "underline",
                animate: false,
            });
        });

        const group = annotationGroup(annotations);
        group.show(); // create the SVGs once (fully drawn); we hide them via dashoffset below

        const DRAW_MS = 500; // draw-in on hover
        const UNDRAW_MS = 260; // reverse-draw on leave
        const LINGER_MS = 1500; // stay drawn after the cursor leaves
        const STAGGER_MS = 110; // delay between each word

        // One <svg.rough-annotation> per annotated word; stagger by word, not by path
        const words = () => card.querySelectorAll("svg.rough-annotation");

        let lingerTimer = 0;
        let primed = false;

        /**
         * Dash each stroke to its own length and retract it fully, so the
         * annotation is present but undrawn.
         *
         * This runs on demand rather than at setup because getTotalLength()
         * returns 0 for a path the browser has not laid out yet, and a stroke
         * dashed to 0 is a stroke with no dashing at all: fully drawn. That is
         * how sketches ended up visible on cards further down the page before
         * anything was hovered. If any path measures 0 we leave the whole card
         * alone (still opacity:0 via .rn-primed in global.css) and try again on
         * the next interaction, by which point it is definitely on screen.
         */
        const prime = () => {
            if (primed) return true;
            const svgs = words();
            if (svgs.length === 0) return false;

            let measured = true;
            svgs.forEach((svg) => {
                svg.querySelectorAll("path").forEach((p) => {
                    const len = p.getTotalLength();
                    if (!len) {
                        measured = false;
                        return;
                    }
                    p.style.strokeDasharray = String(len);
                    p.style.strokeDashoffset = String(len);
                });
            });
            if (!measured) return false;

            svgs.forEach((svg) => svg.classList.add("rn-primed"));
            primed = true;
            return true;
        };

        const drawIn = () => {
            if (!prime()) return;
            // The retracted state has to paint before the transition starts,
            // otherwise the browser coalesces both into one frame and the
            // annotation simply appears, fully drawn, with no draw at all.
            requestAnimationFrame(() => {
                words().forEach((svg, i) => {
                    const delay = i * STAGGER_MS; // left-to-right
                    svg.querySelectorAll("path").forEach((p) => {
                        p.style.transition = `stroke-dashoffset ${DRAW_MS}ms ease ${delay}ms`;
                        p.style.strokeDashoffset = "0";
                    });
                });
            });
        };

        const drawOut = () => {
            const svgs = words();
            const last = svgs.length - 1;
            svgs.forEach((svg, i) => {
                const delay = (last - i) * STAGGER_MS; // reverse order, so it rewinds
                svg.querySelectorAll("path").forEach((p) => {
                    const len = p.style.strokeDasharray || String(p.getTotalLength());
                    p.style.transition = `stroke-dashoffset ${UNDRAW_MS}ms ease-in ${delay}ms`;
                    p.style.strokeDashoffset = len;
                });
            });
        };

        // Desktop: the text stands on its own and the annotation is a reward for
        // hovering. Touch devices have no hover, so there the card draws itself
        // in once when it is properly on screen.
        const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

        if (canHover) {
            card.addEventListener("mouseenter", () => {
                clearTimeout(lingerTimer);
                drawIn();
            });

            card.addEventListener("mouseleave", () => {
                clearTimeout(lingerTimer);
                lingerTimer = window.setTimeout(drawOut, LINGER_MS);
            });
            return;
        }

        const io = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    io.disconnect();
                    drawIn();
                }
            },
            { threshold: 0.6 },
        );
        io.observe(card);
    }

    function setupAnnotations() {
        const cards = Array.from(document.querySelectorAll("[data-rn-card]"));
        // Offset each card's color start so adjacent cards don't open on the same hue
        cards.forEach((card, i) => setupCard(card, i * 2));
    }

    // Run on first load and after every View Transitions navigation
    document.addEventListener("astro:page-load", setupAnnotations);
</script>
