---
/**
 * Chapter mark: the chapter's title in one or two lines, one voice
 * throughout: the same face, weight and white in every line, no accent
 * word and no number.
 *
 * The title is set, not stretched: both lines share one size and the
 * font's own spacing, flush left, sized so the longer line spans the mark
 * once the letters have settled open (global.css, --settle). Plain HTML
 * text, not SVG: WebKit re-snaps SVG glyphs as the layer moves by
 * fractions of a pixel, which read as the headlines shivering under touch
 * scrolling.
 *
 * `width` sizes the mark; the type scales with it (cqw), so the mark stays
 * one proportional unit. A soft lens (data-lens, clouds.ts) dims the cloud
 * behind the mark while it stands in place.
 */
const {
    line1,
    line2,
    width = "w-[min(18rem,84vw)] lg:w-[min(28rem,36vw)]",
} = Astro.props;

const lines = [line1, line2].filter(Boolean) as string[];
/** The longer line fills the mark at the settled width, measured at about
 *  0.86 of the size per character. As a share of the mark's width. */
const longest = Math.max(...lines.map((l) => l.length));
const titleSize = `${(100 / (0.86 * longest)).toFixed(3)}cqw`;

// The mark is drawn twice: the letters themselves, and behind them the
// light they catch once their chapter settles (global.css .cm-fringe,
// smoothScroll.ts --settle). The fringe copy disperses each line into a cool
// and a warm copy either side, blurred as one layer.
const layers = ["body", "fringe"] as const;
const tones = (layer: (typeof layers)[number]) =>
    layer === "body" ? [undefined] : ["cm-cool", "cm-warm"];
---

<div class:list={["chapter-mark relative isolate inline-block select-none", width]} data-lens
     style={`--cm-size: ${titleSize}`}>
    {layers.map((layer) => (
        <div class:list={["cm-layer", { "cm-split": layer === "body", "cm-fringe": layer === "fringe" }]}
             aria-hidden={layer === "fringe" ? "true" : undefined}>
            {tones(layer).map((tone) => (
                <p class:list={["cm-title", tone]}>
                    {lines.map((line) => <span class="cm-line">{line}</span>)}
                </p>
            ))}
        </div>
    ))}
</div>

<script>
    // Point the hover split away from the mark's centre, toward the pointer.
    // One document listener survives page swaps; near the centre the
    // direction keeps a floor so the split never collapses to nothing.
    document.addEventListener("pointermove", (event) => {
        if (event.pointerType === "touch") return;
        const mark = (event.target as Element | null)?.closest?.<HTMLElement>(".chapter-mark");
        if (!mark) return;
        const r = mark.getBoundingClientRect();
        const x = (event.clientX - r.left) / r.width * 2 - 1;
        const y = (event.clientY - r.top) / r.height * 2 - 1;
        const length = Math.max(Math.hypot(x, y), 0.35);
        mark.style.setProperty("--cm-x", (x / length).toFixed(3));
        mark.style.setProperty("--cm-y", (y / length).toFixed(3));
    }, { passive: true });
</script>
