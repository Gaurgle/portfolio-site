---
/**
 * Chapter mark as one symmetrical rectangle, numeral on top: the number is
 * SVG text stretched to the full rectangle width, with the title line(s)
 * beneath - all stretched to fill the box exactly, flush on both edges.
 * One voice throughout: the same face, weight and white in every line, no
 * accent word.
 *
 * Each title line's font-size is fitted to its text length so short lines
 * get bigger glyphs instead of letter-spacing gaps (textLength then only
 * fine-tunes), keeping the letters tight.
 *
 * `width` sizes the whole rectangle; everything inside scales via
 * aspect-ratio, so the mark stays one proportional unit. `label` names the
 * chapter for assistive tech only. A soft lens (data-lens, clouds.ts) dims
 * the cloud behind the mark while it stands in place.
 */
const {
    n,
    label,
    line1,
    line2,
    width = "w-[min(18rem,84vw)] lg:w-[min(28rem,36vw)]",
} = Astro.props;

/** Fit a line: font-size such that the text naturally fills ~720 units. */
function fit(text: string) {
    const fs = Math.min(220, Math.round(760 / (0.6 * text.length)));
    return { fs, vb: Math.round(fs * 1.1), y: Math.round(fs * 0.9) };
}

const lines = [line1, line2].filter(Boolean) as string[];
// Row boxes are sized with the padding-top hack instead of CSS aspect-ratio:
// the svgs' viewBoxes deliberately differ from the box ratio (the text is
// stretched to fill via preserveAspectRatio="none"), and WebKit lets an
// svg's intrinsic viewBox ratio beat CSS aspect-ratio, collapsing the row.
// Percentages are relative to the mark's width: 300/720 and 115/720.
// The box height alone decides how tall the glyphs render, because the
// viewBox is scaled to fit it - font-size only trades stroke width against
// letter spacing. So every title row shares one percentage, and the four
// marks read as one family.
const hookPad = "15.98%";

// The mark is drawn twice: the letters themselves, and behind them the
// light they catch once their chapter settles (global.css .cm-fringe,
// smoothScroll.ts --settle). The fringe copy disperses each line into a cool
// and a warm copy a few units either side, blurred as one layer.
const layers = ["body", "fringe"] as const;
const shifts = (layer: (typeof layers)[number]): Array<[number, string | undefined]> =>
    layer === "body" ? [[0, undefined]] : [[-5, "cm-cool"], [5, "cm-warm"]];
---

<div class:list={["chapter-mark relative isolate inline-block select-none", width]} data-lens
     aria-label={`${n} ${label}: ${lines.join(" ")}`}>
    {layers.map((layer) => (
        <div class:list={["cm-layer", { "cm-fringe": layer === "fringe" }]} aria-hidden={layer === "fringe" ? "true" : undefined}>
            <!-- Numeral: slightly WIDER than the title lines (optical alignment reads
                 better with a small overhang than with exact equal widths) -->
            <div class:list={[{ "cm-split cm-num-box": layer === "body" }, "cm-num-row relative w-[106%] -ml-[3%]"]} style="padding-top: var(--cm-num-pad, 44.17%)">
                <svg class="absolute inset-0 h-full w-full" viewBox="0 0 720 300" preserveAspectRatio="none" aria-hidden="true">
                    {shifts(layer).map(([dx, tone]) => (
                        <text class:list={["cm-num", tone]} x={-8 + dx} y="290" font-size="400" textLength="736" lengthAdjust="spacingAndGlyphs">{n}</text>
                    ))}
                </svg>
            </div>

            <!-- Title: one or two rows, tight letters, flush to the rectangle edges -->
            <div class:list={[{ "cm-split": layer === "body" }, "cm-title mt-[4%] space-y-[3%]"]}>
                {lines.map((line) => {
                    const f = fit(line);
                    return (
                        <div class="relative w-full" style={`padding-top: ${hookPad}`}>
                            <svg class="absolute inset-0 h-full w-full" viewBox={`0 0 720 ${f.vb}`} preserveAspectRatio="none" aria-hidden="true">
                                {shifts(layer).map(([dx, tone]) => (
                                    <text class={tone} x={dx} y={f.y} font-size={f.fs} textLength="720" lengthAdjust="spacingAndGlyphs">{line}</text>
                                ))}
                            </svg>
                        </div>
                    );
                })}
            </div>
        </div>
    ))}
</div>

<script>
    // Point the hover split away from the mark's centre, toward the pointer.
    // One document listener survives page swaps; near the centre the
    // direction keeps a floor so the split never collapses to nothing.
    document.addEventListener("pointermove", (event) => {
        if (event.pointerType === "touch") return;
        const mark = (event.target as Element | null)?.closest?.<HTMLElement>(".chapter-mark");
        if (!mark) return;
        const r = mark.getBoundingClientRect();
        const x = (event.clientX - r.left) / r.width * 2 - 1;
        const y = (event.clientY - r.top) / r.height * 2 - 1;
        const length = Math.max(Math.hypot(x, y), 0.35);
        mark.style.setProperty("--cm-x", (x / length).toFixed(3));
        mark.style.setProperty("--cm-y", (y / length).toFixed(3));
    }, { passive: true });
</script>
