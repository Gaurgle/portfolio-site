---
/**
 * Featured projects as a pinned strip (desktop): the chapter mark enters
 * centered, the first project flies in and pushes it out, each project
 * leaves left as the next arrives, and the last one exits as the listing
 * below climbs in (smoothScroll.ts measureShowcases drives all transforms).
 * Projects have no surface, so nothing piles. On mobile the same markup
 * flies through in depth like the journey (the engine's focus stack).
 */
import { projects } from "../../data/projects";
import ChapterMark from "./ChapterMark.astro";
import { imageSize } from "../../data/imageSizes";

const featured = projects
    .filter((p) => p.featured)
    .sort((a, b) => (a.featuredOrder ?? 99) - (b.featuredOrder ?? 99));
const firstImage = (p: (typeof projects)[number]) =>
    Array.isArray(p.image) ? p.image[0] : p.image;
// Every shot of a project, so the lightbox can page through them all
const allImages = (p: (typeof projects)[number]) =>
    (Array.isArray(p.image) ? p.image : [p.image]).filter(Boolean) as string[];
---

<div data-hscroll data-hscroll-mode="strip" data-cardstack data-stack-mode="focus" class="hscroll-pin relative">
    <div class="hscroll-viewport">
        <!-- Chapter mark: pinned WITH the strip, centered until the first
             card arrives and pushes it out left -->
        <div class="absolute inset-0 hidden lg:flex items-center justify-center z-0">
            <div data-cover-content class="will-change-transform">
                <ChapterMark line1="Selected" line2="work" />
            </div>
        </div>

        <!-- Mobile: compact chapter header sharing the pinned screen with
             the deck (the mark is slimmed via .hscroll-pin .chapter-mark) -->
        <div class="lg:hidden px-4 pb-5 text-center">
            <ChapterMark line1="Selected" line2="work" />
        </div>

        <div data-hscroll-track class="relative z-10 px-4" style="--deck-n: 0">
            {featured.map((p, i) => (
                <div class="featured-card" data-spotlight data-stack-card
                     style={`--f: ${i === 0 ? 0 : -1}`}>
                    <div class="edit-card h-full">
                        {firstImage(p) ? (
                            <div class="edit-media">
                                <button type="button"
                                        class="flex h-full w-full items-center cursor-zoom-in"
                                        aria-label={`Open ${p.projectTitle} screenshots`}
                                        data-lightbox
                                        data-images={JSON.stringify(allImages(p))}
                                        data-title={p.projectTitle}>
                                    {"mockup" in p ? (
                                        <span class="shot-frame" style={`--shot-ratio: ${imageSize(firstImage(p)!).width ?? 16} / ${imageSize(firstImage(p)!).height ?? 9}`}>
                                            <img src={firstImage(p)} {...imageSize(firstImage(p)!)} alt={`${p.projectTitle} screenshot`} loading="lazy" decoding="async"
                                                 class="h-full w-full object-contain transition-all duration-500 cursor-zoom-in" />
                                            <span class="wip-note wip-note-over absolute top-2 right-2">Mockup</span>
                                        </span>
                                    ) : (
                                        <img src={firstImage(p)} {...imageSize(firstImage(p)!)} alt={`${p.projectTitle} screenshot`} loading="lazy" decoding="async"
                                             class="h-full w-full object-contain transition-all duration-500 cursor-zoom-in" />
                                    )}
                                </button>
                            </div>
                        ) : (
                            <div class="edit-media flex items-center justify-center text-sm text-zinc-500">
                                <span>No preview yet</span>
                            </div>
                        )}
                        <div class="edit-body" data-lens>
                            <h3 class="text-2xl md:text-4xl font-bold leading-[1.05] text-white mb-4 md:mb-5">
                                {p.projectTitle}.
                            </h3>
                            <div class="edit-cols">
                                <p class="edit-desc">{p.details?.long}</p>
                                <div class="space-y-2.5">
                                    <ul class="space-y-1.5">
                                        {p.details?.highlights.slice(0, 3).map((h) => (
                                            <li>
                                                <span class="mr-1.5 text-zinc-500">▸</span>{h}
                                            </li>
                                        ))}
                                    </ul>
                                    <div class="flex items-start gap-4">
                                        <p class="project-stack text-zinc-400">
                                            {p.tags?.map((tag, i, all) => (
                                                <><span class="whitespace-nowrap">{tag}{i < all.length - 1 && ","}</span>{" "}</>
                                            ))}
                                        </p>
                                        {p.wip && <span class="wip-note ml-auto shrink-0">In progress</span>}
                                    </div>
                                    {p.link && p.link !== "#" && (
                                        <a href={p.link} target="_blank" rel="noopener noreferrer"
                                           class="text-link inline-block text-sm">
                                            Source on GitHub
                                        </a>
                                    )}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            ))}

        </div>
    </div>
</div>

<script>
    import { lightboxPair, swapShot } from "../../lib/shotTransition";
    import { fitLines } from "../../lib/fitLines";

    /** True from the click that opens a lightbox until it is asked to close. */
    let lightboxOpen = false;

    /**
     * Featured shots expand on click. The grid below uses the React Lightbox;
     * this strip is server-rendered with no island, so it gets a small vanilla
     * twin that matches it (terminal bar, backdrop, arrow + Esc keys). The
     * card's picture grows into it and goes back on close (shotTransition).
     */
    function openLightbox(images: string[], title: string, opener: HTMLElement) {
        let index = 0;

        const overlay = document.createElement("div");
        overlay.className =
            "fixed inset-0 z-[100] flex items-center justify-center bg-black/80";
        overlay.dataset.shotScrim = "";
        overlay.setAttribute("role", "dialog");
        overlay.setAttribute("aria-modal", "true");
        overlay.setAttribute("aria-label", title);

        const frame = document.createElement("div");
        frame.className = "shot-pane";
        frame.addEventListener("click", (e) => e.stopPropagation());

        const bar = document.createElement("div");
        bar.className = "terminal-bar";

        const label = document.createElement("span");
        label.textContent = title;
        bar.appendChild(label);

        const closeBtn = document.createElement("button");
        closeBtn.type = "button";
        closeBtn.className = "pane-close";
        closeBtn.setAttribute("aria-label", "Close screenshots");
        bar.appendChild(closeBtn);

        const img = document.createElement("img");
        img.className = "w-full max-h-[75vh] object-contain bg-black";
        img.src = images[0];
        img.alt = title;
        img.dataset.shot = "";

        const close = () => {
            if (!lightboxOpen) return;
            lightboxOpen = false;
            document.removeEventListener("keydown", onKey);
            swapShot(lightboxPair(), () => {
                overlay.remove();
                opener.focus();
                return { shot: opener.querySelector("img") };
            });
        };

        const step = (delta: number) => {
            index = (index + delta + images.length) % images.length;
            img.src = images[index];
        };

        /** Every control in the dialog is a button, so this is the tab ring. */
        const controls = () => Array.from(frame.querySelectorAll("button"));

        // Nothing behind the overlay should be tabbable while it is open.
        const trapTab = (e: KeyboardEvent) => {
            const items = controls();
            if (!items.length) return;
            const edge = e.shiftKey ? items[0] : items[items.length - 1];
            const wrap = e.shiftKey ? items[items.length - 1] : items[0];
            const active = document.activeElement;
            if (active === edge || !frame.contains(active)) {
                e.preventDefault();
                wrap.focus();
            }
        };

        function onKey(e: KeyboardEvent) {
            if (e.key === "Escape") close();
            if (e.key === "Tab") trapTab(e);
            if (images.length > 1 && e.key === "ArrowRight") step(1);
            if (images.length > 1 && e.key === "ArrowLeft") step(-1);
        }

        if (images.length > 1) {
            for (const [dir, glyph, side, name] of [
                [-1, "‹", "left-2", "Previous screenshot"],
                [1, "›", "right-2", "Next screenshot"],
            ] as const) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = `shot-step ${side}`;
                btn.textContent = glyph;
                btn.setAttribute("aria-label", name);
                btn.addEventListener("click", () => step(dir));
                frame.appendChild(btn);
            }
        }

        overlay.addEventListener("click", close);
        closeBtn.addEventListener("click", close);
        frame.prepend(img);
        frame.prepend(bar);
        overlay.appendChild(frame);
        document.body.appendChild(overlay);
        document.addEventListener("keydown", onKey);
        closeBtn.focus();
    }

    function wireLightboxes() {
        for (const el of document.querySelectorAll<HTMLButtonElement>("button[data-lightbox]")) {
            if (el.dataset.lightboxWired) continue;
            el.dataset.lightboxWired = "1";
            el.addEventListener("click", () => {
                let images: string[] = [];
                try {
                    images = JSON.parse(el.dataset.images ?? "[]");
                } catch {
                    images = [];
                }
                const shot = el.querySelector("img");
                if (images.length === 0 && shot) images = [shot.src];
                if (images.length === 0 || lightboxOpen) return;
                lightboxOpen = true;
                swapShot({ shot }, () => {
                    openLightbox(images, el.dataset.title ?? "", el);
                    return lightboxPair();
                });
            });
        }
    }

    document.addEventListener("astro:page-load", wireLightboxes);

    /** Phones deal the projects as fixed-height cards: each description
     *  gives up whole lines until its card holds title, copy and tags
     *  without scrolling. */
    let unfit: Array<() => void> = [];
    document.addEventListener("astro:page-load", () => {
        if (!window.matchMedia("(max-width: 1023px)").matches) return;
        for (const body of document.querySelectorAll<HTMLElement>(".hscroll-pin .featured-card .edit-body")) {
            const desc = body.querySelector<HTMLElement>(".edit-desc");
            if (desc) unfit.push(fitLines(desc, body, 6));
        }
    });
    document.addEventListener("astro:before-swap", () => {
        unfit.forEach((stop) => stop());
        unfit = [];
    });
</script>
