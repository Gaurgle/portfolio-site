---
import {ClientRouter} from "astro:transitions";
const {title, description} = Astro.props;

const SITE_URL = "https://andreasroos.vercel.app/";
const OG_IMAGE = "https://andreasroos.vercel.app/og.jpg";
const DEFAULT_TITLE = "Andreas Roos";
const DEFAULT_DESCRIPTION = "Backend and Android developer in Stockholm. Kotlin, Jetpack Compose, Spring Boot, Ktor, Bluetooth LE and LE Audio. 15 years in music before code.";

const pageTitle = title ?? DEFAULT_TITLE;
const pageDescription = description ?? DEFAULT_DESCRIPTION;

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Andreas Roos",
    jobTitle: "Backend & Android developer",
    url: SITE_URL,
    description: DEFAULT_DESCRIPTION,
    sameAs: [
        "https://github.com/gaurgle/",
        "https://www.linkedin.com/in/andreasrooos/"
    ],
    address: {
        "@type": "PostalAddress",
        addressLocality: "Stockholm",
        addressCountry: "SE"
    }
};
---
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="theme-color" content="#000000"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<meta name="generator" content={Astro.generator}/>

<title>{pageTitle}</title>
<meta name="description" content={pageDescription}/>
<link rel="canonical" href={SITE_URL}/>

<!-- Only the faces painted above the fold are preloaded: the hero path line
     and nav (mono 400) and the chapter marks (Inter 800, Archivo Black).
     The rest load on demand from the @font-face rules in global.css. -->
<link rel="preload" as="font" type="font/woff2" href="/fonts/noto-sans-mono-latin-400-normal.woff2" crossorigin/>
<link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-800-normal.woff2" crossorigin/>
<link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-black-latin-400-normal.woff2" crossorigin/>

<meta property="og:type" content="website"/>
<meta property="og:url" content={SITE_URL}/>
<meta property="og:site_name" content="Andreas Roos"/>
<meta property="og:title" content={pageTitle}/>
<meta property="og:description" content={pageDescription}/>
<meta property="og:image" content={OG_IMAGE}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:type" content="image/jpeg"/>
<meta property="og:image:alt" content="ASCII art wordmark reading ROOS on a black starfield"/>

<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={pageTitle}/>
<meta name="twitter:description" content={pageDescription}/>
<meta name="twitter:image" content={OG_IMAGE}/>

<script type="application/ld+json" set:html={JSON.stringify(personSchema)}/>

<ClientRouter/>
