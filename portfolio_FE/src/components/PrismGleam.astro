---
/** A wordless optical interlude between the introduction and the journey. */
---

<section data-prism-scene class="prism-scene relative h-[150svh] lg:h-[165vh]" aria-hidden="true">
    <div class="sticky top-0 h-[100svh] lg:h-screen overflow-hidden pointer-events-none">
        <canvas data-prism-canvas class="absolute inset-0 h-full w-full"></canvas>
        <div class="prism-vignette absolute inset-0"></div>
    </div>
</section>

<style>
    .prism-scene {
        isolation: isolate;
        margin-inline: calc(50% - 50vw);
        width: 100vw;
    }
    [data-prism-canvas] {
        z-index: 0;
        opacity: .96;
    }
    .prism-vignette {
        z-index: 1;
        background:
            linear-gradient(to bottom, #000 0%, transparent 18%, transparent 82%, #000 100%),
            radial-gradient(ellipse at center, transparent 35%, rgb(0 0 0 / .42) 100%);
    }
    @media (max-width: 1023px) {
        [data-prism-canvas] { opacity: .9; }
        .prism-vignette {
            background:
                linear-gradient(to bottom, #000 0%, transparent 16%, transparent 84%, #000 100%),
                radial-gradient(ellipse at center, transparent 46%, rgb(0 0 0 / .28) 100%);
        }
    }
</style>

<script>
    import { mountPrismGleam } from "../lib/prismGleam";

    let dispose: (() => void) | undefined;
    document.addEventListener("astro:page-load", () => {
        dispose?.();
        const section = document.querySelector<HTMLElement>("[data-prism-scene]");
        const canvas = section?.querySelector<HTMLCanvasElement>("[data-prism-canvas]");
        dispose = section && canvas ? mountPrismGleam(section, canvas) : undefined;
    });
    document.addEventListener("astro:before-swap", () => {
        dispose?.();
        dispose = undefined;
    });
</script>
