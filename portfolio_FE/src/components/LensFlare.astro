---
/** Camera lens flare off the MORE PROJECTS arrow while it holds the stage.
 *  In front of the page: a flare is made in the lens. */
---
<canvas id="lens-flare" aria-hidden="true"></canvas>

<style>
    #lens-flare {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100vh;
        z-index: 12;
        pointer-events: none;
    }
</style>

<script>
    import { mountLensFlare } from "../lib/lensFlare";
    let dispose: (() => void) | undefined;
    document.addEventListener("astro:page-load", () => {
        dispose?.();
        const canvas = document.querySelector<HTMLCanvasElement>("#lens-flare");
        if (!canvas) { dispose = undefined; return; }
        let release = mountLensFlare(canvas);
        const restore = () => { release(); release = mountLensFlare(canvas); };
        canvas.addEventListener("webglcontextrestored", restore);
        dispose = () => {
            canvas.removeEventListener("webglcontextrestored", restore);
            release();
        };
    });
    document.addEventListener("astro:before-swap", () => { dispose?.(); dispose = undefined; });
</script>
