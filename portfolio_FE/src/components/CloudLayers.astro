---
/** Volumetric atmosphere. At section entrances the dense parts of the nearest
 *  cloud are copied onto a front canvas, so it passes in front of the content. */
---
<canvas id="cloud-atmosphere" aria-hidden="true"></canvas>
<canvas id="cloud-foreground" aria-hidden="true"></canvas>

<style>
    /* No CSS opacity: the sky's 0.85 opacity is applied in the shader
       (clouds.ts), so the front copy and the sky behind share one look. */
    #cloud-atmosphere, #cloud-foreground {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100svh;
        z-index: 1;
        pointer-events: none;
    }
    #cloud-foreground { z-index: 11; }
    @media (min-width: 1024px) {
        #cloud-atmosphere, #cloud-foreground { height: 100vh; }
    }
</style>

<script>
    import { mountClouds } from "../lib/clouds";
    let dispose: (() => void) | undefined;
    document.addEventListener("astro:page-load", () => {
        dispose?.();
        const canvas = document.querySelector<HTMLCanvasElement>("#cloud-atmosphere");
        if (!canvas) { dispose = undefined; return; }
        const foreground = document.querySelector<HTMLCanvasElement>("#cloud-foreground");
        let release = mountClouds(canvas, foreground);
        // mountClouds compiles its shaders and draws a first frame before it
        // returns. Two frames on, the sky is on screen: the loading screen
        // (index.astro) can lift.
        requestAnimationFrame(() => requestAnimationFrame(() =>
            document.dispatchEvent(new Event("sky:ready"))));
        const restore = () => { release(); release = mountClouds(canvas, foreground); };
        canvas.addEventListener("webglcontextrestored", restore);
        dispose = () => {
            canvas.removeEventListener("webglcontextrestored", restore);
            release();
        };
    });
    document.addEventListener("astro:before-swap", () => { dispose?.(); dispose = undefined; });
</script>
