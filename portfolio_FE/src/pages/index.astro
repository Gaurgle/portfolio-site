---
import BaseLayout from "../layouts/BaseLayout.astro";
import MiniTerminal from "../components/MiniTerminal";
import AboutSection from "../components/sections/AboutSection.astro";
import JourneySection from "../components/sections/JourneySection.astro";
import ContactPanel from "../components/sections/ContactPanel.astro";
import FeaturedShowcase from "../components/sections/FeaturedShowcase.astro";
import TechMarquee from "../components/TechMarquee.tsx";
import ProjectsGrid from "../components/ProjectsGrid.tsx";

// Rendered three times: the mark itself, its reflection on the ground line
// it rises through on arrival (global.css, .hero-mark-ground), and its ghost
// on the loading screen. The letters are drawn with box pieces for their
// outline and solid blocks for their body, so blanking the blocks leaves an
// outline the loading screen fills in.
const ROOS = `
██████╗  ██████╗  ██████╗ ███████╗
██╔══██╗██╔═══██╗██╔═══██╗██╔════╝
██████╔╝██║   ██║██║   ██║███████╗
██╔══██╗██║   ██║██║   ██║╚════██║
██║  ██║╚██████╔╝╚██████╔╝███████║
╚═╝  ╚═╝ ╚═════╝  ╚═════╝ ╚══════╝
`;
const ROOS_OUTLINE = ROOS.replace(/█/g, " ");
---
<BaseLayout title="Andreas Roos" current="/" revealFooter>
    <ContactPanel slot="reveal-panel" />

    <!-- ================= HERO ================= -->
    <!-- Negative top margin cancels the layout's header padding, so the hero
         is pinned and truly centered at scroll 0 (no tiny settle-scroll) -->
    <!-- Pin holds past the ROOS dissolve (~0.63vh of scrub) until the hero
         cloud, lifted in front as a curtain (clouds.ts), has nearly reached
         the camera (1.15vh): the first chapter is uncovered, not overlaid. -->
    <section id="home" data-section="home" data-pin="1" data-pin-mobile
             data-hue="#8dffb0"
             class="relative -mt-[80px] md:-mt-[100px]">
        <!-- Full first screen on mobile (lvh: the screen with the browser
             bar hidden, matching the engine's pin height) so nothing peeks
             below the hero when the bar goes. The hero pins
             on mobile too (data-pin-mobile), so the explosion plays out while
             the screen holds still instead of during the scroll-away. -->
        <!-- pb lifts the centered content ~4.5vh above geometric center:
             optically balanced instead of reading slightly low -->
        <div data-hero-scrub class="pin-viewport relative min-h-[100lvh] lg:min-h-[calc(100vh-120px)] flex flex-col items-center justify-center pb-[9svh] lg:pb-[9vh]">
        <div class="hero-boom max-w-4xl mx-auto px-4 flex flex-col items-center justify-center text-center">

            <!-- ASCII Art Name with pixelated glow. Bottom margin stays wide
                 enough that the hover sketch underline clears the tagline. -->
            <!-- The glyph is decorative ASCII: the sr-only span carries the
                 real heading text for assistive tech and search. h1 is
                 display: contents so the visual layout is unchanged. -->
            <h1 class="contents">
                <span class="sr-only">Andreas Roos</span>
            <div class="hero-mark relative mb-8">
                <!-- Loading screen only: a dark grey ghost of the mark where
                     it will stand. Its outline is there at once; its body
                     fills in from the ground up over the black floor, the loader
                     bar drawn as the mark itself. Plain text, nothing to
                     load. It stays while the white mark sweeps over it. -->
                <div class="hero-mark-ghost text-xs sm:text-base md:text-xl lg:text-2xl" aria-hidden="true">
                    <pre class="font-mono ascii-art select-none" set:html={ROOS_OUTLINE} />
                    <pre class="hero-mark-ghost-fill font-mono ascii-art select-none" set:html={ROOS} />
                </div>
                <!-- The mark itself: rises up out of the ground on arrival. -->
                <div class="hero-mark-sky text-xs sm:text-base md:text-xl lg:text-2xl">
                <!-- Built like the ghost: the outline drawn once more under
                     the full mark, so the box pieces read as solid as the
                     blocks and the two match exactly as one sweeps over
                     the other. -->
                <pre class="hero-mark-glyphs hero-mark-outline font-mono ascii-art text-white select-none" aria-hidden="true" set:html={ROOS_OUTLINE} />
                <!-- The glow is real light: clouds.ts streams volumetric rays
                     out of these glyphs (lightBurst.ts), so there is no
                     painted halo behind them -->
                <pre data-roos aria-hidden="true" class="hero-mark-glyphs font-mono ascii-art text-white ascii-glow select-none cursor-pointer" set:html={ROOS} />
                </div>
                <!-- Ground half: the mark's radiance mirrored on a ground
                     line, unfolding from it as its mirror, gone once it stands. -->
                <!-- The size classes sit on the ground itself, so its
                     perspective (in em) is measured in the glyphs' size. -->
                <div class="hero-mark-ground text-xs sm:text-base md:text-xl lg:text-2xl" aria-hidden="true">
                    <pre class="font-mono ascii-art text-white select-none" set:html={ROOS} />
                </div>
                <!-- A soft black haze along the line, so neither the rising
                     glyphs nor their reflection are cut with a hard edge. -->
                <div class="hero-mark-horizon text-xs sm:text-base md:text-xl lg:text-2xl" aria-hidden="true"></div>
            </div>
            </h1>


        </div>

        <!-- The loading screen fades the tagline in as a unit (its own
             opacity belongs to the scrubbed dissolve). -->
        <div class="hero-lines flex flex-col items-center">
        <!-- Separate words let the glitch shift them independently. -->
        <p class="hero-tagline font-mono text-sm sm:text-base md:text-lg text-zinc-200 tracking-wide whitespace-nowrap -mt-2"><span class="hero-tag" style="--glitch-direction: -1">Backend</span> <span class="text-zinc-500">-</span> <span class="hero-tag" style="--glitch-direction: 0.7">Android</span> <span class="text-zinc-500">-</span> <span class="hero-tag" style="--glitch-direction: -0.6">Bluetooth LE</span> <span class="text-zinc-500">-</span> <span class="hero-tag" style="--glitch-direction: 1">Stockholm</span></p>
        </div>

        </div>
    </section>

    <!-- ================= ABOUT ================= -->
    <AboutSection />

    <!-- ================= JOURNEY (pinned card stack) ================= -->
    <JourneySection />

    <!-- ================= TECH MARQUEE ================= -->
    <!-- Unpinned: it reads as a palate-cleanser divider between the two big
         chapters, not a held moment - and every other section already pins. -->
    <section class="relative py-8">
        <TechMarquee client:idle />
    </section>

    <!-- ================= PROJECTS ================= -->
    <!-- Desktop tail: the ls listing is short, and without this cushion it
         would rest inside the contact reveal band (the magnet would pull
         the page away while the visitor reads the list) -->
    <section id="projects" data-section="projects"
             data-hue="#46beff"
             class="relative max-w-6xl mx-auto px-4 pb-16 lg:pb-[30vh]">
        <!-- Flagship projects: pinned horizontal filmstrip; the 03 chapter
             mark lives inside the strip's viewport and gets pushed out by
             the first card -->
        <FeaturedShowcase />

        <!-- ...then the rest, flowing freely: after the pinned filmstrip a
             plain-scrolling grid is the contrast that makes the pins land -->
        <!-- Negative top margin on desktop: the grid climbs over the arrow's
             tail while it is still fading out, so the two overlap instead of
             handing off across a gap of empty scroll. -->
        <!-- more-projects-stage: on wide screens the listing grows past the
             section's reading column (global.css), so the viewer's picture
             is sized for the screen and not for a 72rem page. -->
        <!-- data-hold: once the listing arrives it stays put for a screen
             and a half of scroll (desktop), so nobody flies past it on the
             way to the contact panel. Seated high (data-hold-at): the
             listing is nearly a screen tall and its last row must fit. -->
        <div data-hold="0.8" data-hold-at="0.09" class="more-projects-stage relative z-10 mt-10 md:mt-[6vh] lg:-mt-[20vh]">
            <div data-hold-content>
                <h3 class="font-bold uppercase tracking-[0.3em] text-xl md:text-2xl text-white/80 select-none mb-10">
                    more projects<span class="text-ctp-blue">.</span>
                </h3>
                <ProjectsGrid client:load />
            </div>
        </div>
    </section>

    <!-- Contact anchor sentinel: scrolling here reveals the fixed panel below the page -->
    <div id="contact" class="h-px"></div>

    <!-- Secret terminal: summoned by clicking ROOS -->
    <div id="secret-terminal" class="hidden fixed bottom-14 right-4 z-50 w-full max-w-md">
        <MiniTerminal client:idle />
    </div>
</BaseLayout>

<script>
    import { projects } from "../data/projects";

    /** Black before ROOS rises, in milliseconds (half a second of the bare
     *  outline, then its one-second fill): at least the floor, and
     *  until the sky's shaders are compiled and the fonts have landed, so
     *  the rise never shares the GPU or its glyphs with that work. The
     *  ceiling is for a browser where the sky never reports in (no WebGL). */
    const BLACK_FLOOR = 1000;
    const BLACK_CEILING = 2500;
    /** From the start of the sweep until the world may fade in: the sweep,
     *  the reflection's lag and a beat with the mark standing (global.css). */
    const RISE_FLOOR = 2300;
    /** Longest the loading screen may stand in all, for a failed island or
     *  a picture that never arrives. */
    const LOADING_CEILING = 5000;
    /** How long the world takes to fade in around ROOS (global.css). */
    const REVEAL = 1400;

    const wait = (ms: number) => new Promise((done) => setTimeout(done, ms));
    const once = (target: EventTarget, name: string) =>
        new Promise((done) => target.addEventListener(name, done, { once: true }));
    /** Fetches and decodes one picture into the browser's cache, so the lazy
     *  img that asks for it later paints at once. Never rejects: a missing
     *  picture must not hold the loading screen. */
    const warm = (src: string, priority: "high" | "low") =>
        new Promise<void>((done) => {
            const img = new Image();
            img.setAttribute("fetchpriority", priority);
            img.onload = () => img.decode().catch(() => {}).then(done);
            img.onerror = () => done();
            img.src = src;
        });
    const pictures = (p: (typeof projects)[number]) =>
        (Array.isArray(p.image) ? p.image : [p.image])
            .filter((src): src is string => typeof src === "string");
    /** The featured cards are the first pictures on the way down, so they are
     *  buffered under the loading screen. Everything after them is warmed in
     *  the background once the world has faded in. */
    const featuredPictures = projects
        .filter((p) => p.featured)
        .map((p) => pictures(p)[0])
        .filter((src): src is string => typeof src === "string");
    const laterPictures = projects
        .flatMap(pictures)
        .filter((src) => !featuredPictures.includes(src));

    /** Keys that scroll the page when nothing focused takes them. */
    const SCROLL_KEYS = new Set([" ", "ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End"]);

    /** Holds the page still at the top while the loading screen stands.
     *  `overflow: hidden` alone stops neither the smooth-scroll engine (it
     *  reads the wheel itself and scrolls from script) nor touch on iOS, so
     *  the input is swallowed before anything else sees it, and any scroll
     *  that still gets through is put back. Returns the release. */
    function holdScroll(): () => void {
        const swallow = (event: Event) => {
            event.preventDefault();
            event.stopImmediatePropagation();
        };
        const swallowKey = (event: KeyboardEvent) => {
            if (SCROLL_KEYS.has(event.key)) swallow(event);
        };
        const pin = () => {
            if (window.scrollY !== 0) window.scrollTo(0, 0);
        };
        const capture = { capture: true, passive: false };
        window.addEventListener("wheel", swallow, capture);
        window.addEventListener("touchmove", swallow, capture);
        window.addEventListener("keydown", swallowKey, capture);
        window.addEventListener("scroll", pin);
        pin();
        return () => {
            window.removeEventListener("wheel", swallow, capture);
            window.removeEventListener("touchmove", swallow, capture);
            window.removeEventListener("keydown", swallowKey, capture);
            window.removeEventListener("scroll", pin);
        };
    }

    document.addEventListener("astro:page-load", () => {
        const root = document.documentElement;
        if (!root.classList.contains("is-loading")) return;
        const releaseScroll = holdScroll();
        // One listener: the event fires once, so it is awaited once and
        // shared by both gates below.
        const skyReady = once(document, "sky:ready");
        // Islands drop their ssr attribute once hydrated, so only the ones
        // still pending are waited on.
        const hydrated = Array.from(document.querySelectorAll("astro-island[ssr]"))
            .map((island) => once(island, "astro:hydrate"));
        // Gate one: black until the rise can run undisturbed. The entrance
        // animations stand paused on their first frame until is-rising.
        const black = Promise.race([
            Promise.all([document.fonts.ready, skyReady, wait(BLACK_FLOOR)]),
            wait(BLACK_CEILING),
        ]);
        const risen = black.then(() => {
            root.classList.add("is-rising");
            return wait(RISE_FLOOR);
        });
        // Gate two: the world fades in once the mark stands and everything
        // the first scroll needs has arrived.
        const ready = Promise.all([
            risen,
            document.readyState === "complete" ? null : once(window, "load"),
            ...hydrated,
            ...featuredPictures.map((src) => warm(src, "high")),
        ]);
        Promise.race([ready, wait(LOADING_CEILING)]).then(() => {
            releaseScroll();
            root.classList.add("is-rising", "is-revealing");
            root.classList.remove("is-loading");
            setTimeout(() => {
                root.classList.remove("is-revealing", "is-rising");
                laterPictures.forEach((src) => warm(src, "low"));
            }, REVEAL);
        });
    });

    document.addEventListener("astro:page-load", () => {
        // Secret: clicking ROOS summons the terminal
        const roos = document.querySelector("[data-roos]");
        const secret = document.getElementById("secret-terminal");
        if (roos && secret) {
            roos.addEventListener("click", () => secret.classList.toggle("hidden"));
        }
    });
</script>
